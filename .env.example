# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL 15+ connection for the app, migrations and seed.
DATABASE_URL=postgres://vms:vms@localhost:5432/vms_dev

# Signs login sessions. At least 32 characters; generate with: openssl rand -base64 48
SESSION_SECRET=

# Shared secret for POST /api/jobs/reminders (header x-job-secret). Leave empty to disable the endpoint.
JOB_SECRET=

# Public base URL, used in supplier links and QR codes.
APP_URL=http://localhost:3000

# Where uploaded evidence is stored (default ./storage).
STORAGE_DIR=./storage

# Business Unit that imported MRRegs go to when the SAP export has no BU column.
DEFAULT_BU_CODE=BU-DEMO

# Optional: password for the demo users created by db:seed (default demo1234).
# SEED_PASSWORD=

# Tests only: database that `npm test` drops and rebuilds on every run.
# TEST_DATABASE_URL=postgres://vms:vms@localhost:5432/vms_test
